  "script": "(function() {\n  // Poppins - document-level so it reaches this block's shadow root.\n  try {\n    if (!document.querySelector('link[data-pr-poppins]')) {\n      var pf = document.createElement('link'); pf.rel = 'stylesheet'; pf.setAttribute('data-pr-poppins', '1');\n      pf.href = 'https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap';\n      document.head.appendChild(pf);\n    }\n  } catch (e) {}\n  // Tiles are plain relative links (no target), so they open in the same tab.\n  // Hide tiles for doctypes the user cannot read, and empty groups.\n  var tiles = root_element.querySelectorAll('a.ppn-tile');\n  var DT = {'propagation-batch':'Propagation Batch','daily-propagation-log':'Daily Propagation Log','propagation-trough':'Propagation Trough','seedling-request':'Seedling Request','seedling-dispatch':'Seedling Dispatch','flower-trial':'Flower Trial','propagation-settings':'Propagation Settings','mother-block':'Mother Block','crop-type':'Crop Type'};\n  tiles.forEach(function(a) {\n    var slug = (a.getAttribute('href') || '').replace('/desk/', '');\n    var dt = DT[slug];\n    if (dt && window.frappe && frappe.boot && frappe.boot.user && frappe.boot.user.can_read && frappe.boot.user.can_read.indexOf(dt) < 0\n        && (frappe.user_roles || []).indexOf('System Manager') < 0) a.classList.add('ppn-hide');\n  });\n  root_element.querySelectorAll('.ppn-sec').forEach(function(t) {\n    var grid = t.nextElementSibling;\n    if (grid && !grid.querySelector('.ppn-tile:not(.ppn-hide)')) { t.classList.add('ppn-hide'); grid.classList.add('ppn-hide'); }\n  });\n})();\n",
  "style": ".ppn{padding:4px 2px;font-family:'Poppins',var(--font-stack),'Inter',sans-serif;}\n.ppn-title{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#8a8f98;font-weight:600;margin:0 0 12px 2px;}\n.ppn-sec{font-size:14px;font-weight:600;letter-spacing:-.01em;margin:18px 0 9px 2px;}\n.ppn-title + .ppn-sec{margin-top:0;}\n.ppn-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;}\n.ppn-tile{display:flex;align-items:center;gap:11px;padding:13px 15px;border:1px solid var(--border-color,#e2e4e9);border-radius:10px;background:var(--card-bg,#fff);text-decoration:none;color:inherit;transition:box-shadow .18s ease,transform .18s ease;}\n.ppn-tile:hover{box-shadow:0 2px 6px rgba(0,0,0,.06);transform:translateY(-1px);text-decoration:none;}\n.ppn-ic{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex:0 0 auto;}\n.ppn-ic svg{width:18px;height:18px;}\n.ppn-tx{display:flex;flex-direction:column;min-width:0;}\n.ppn-lb{font-size:13px;font-weight:600;letter-spacing:-.01em;}\n.ppn-sub{font-size:11px;color:#8a8f98;margin-top:1px;}\n.ppn-hide{display:none !important;}\n"
 }
]