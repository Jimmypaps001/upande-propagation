inecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 3v18h18\"/><path d=\"m19 9-5 5-4-4-3 3\"/></svg></span>\n      <span class=\"ppn-tx\"><span class=\"ppn-lb\">Propagation Dashboard</span><span class=\"ppn-sub\">Desk dashboard</span></span>\n    </a>\n    <a class=\"ppn-tile\" href=\"/propagation-dashboard\">\n      <span class=\"ppn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\"/></svg></span>\n      <span class=\"ppn-tx\"><span class=\"ppn-lb\">Portal Dashboard</span><span class=\"ppn-sub\">The portal dashboard page</span></span>\n    </a>\n    <a class=\"ppn-tile\" href=\"/propagation\">\n      <span class=\"ppn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M2 12h20\"/><path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"/></svg></span>\n      <span class=\"ppn-tx\"><span class=\"ppn-lb\">Portal View</span><span class=\"ppn-sub\">The public batch portal</span></span>\n    </a>\n  </div>\n  <div class=\"ppn-sec\">Setup</div>\n  <div class=\"ppn-grid\">\n    <a class=\"ppn-tile\" href=\"/desk/propagation-settings\">\n      <span class=\"ppn-ic\" style=\"background:rgba(107,114,128,.13);color:#6b7280\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg></span>\n      <span class=\"ppn-tx\"><span class=\"ppn-lb\">Propagation Settings</span><span class=\"ppn-sub\">Stages, defaults, invoicing</span></span>\n    </a>\n    <a class=\"ppn-tile\" href=\"/desk/propagation-trough\">\n      <span class=\"ppn-ic\" style=\"background:rgba(107,114,128,.13);color:#6b7280\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 10h18l-2 10H5z\"/><path d=\"M8 10V7M12 10V5M16 10V7\"/></svg></span>\n      <span class=\"ppn-tx\"><span class=\"ppn-lb\">Propagation Troughs</span><span class=\"ppn-sub\">Trough master list</span></span>\n    </a>\n    <a class=\"ppn-tile\" href=\"/desk/crop-type\">\n      <span class=\"ppn-ic\" style=\"background:rgba(107,114,128,.13);color:#6b7280\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12.59 2.59A2 2 0 0 0 11.17 2H4a2 2 0 0 0-2 2v7.17a2 2 0 0 0 .59 1.42l8.7 8.7a2.4 2.4 0 0 0 3.42 0l6.58-6.58a2.4 2.4 0 0 0 0-3.42z\"/><circle cx=\"7.5\" cy=\"7.5\" r=\".5\"/></svg></span>\n      <span class=\"ppn-tx\"><span class=\"ppn-lb\">Crop Type</span><span class=\"ppn-sub\">Crops that are propagated</span></span>\n    </a>\n  </div>\n</div>\n",
