  "html": "<div class=\"ppn\">\n  <div class=\"ppn-title\">Propagation</div>\n  <div class=\"ppn-sec\">Propagation app</div>\n  <div class=\"ppn-grid\">\n    <a class=\"ppn-tile\" href=\"/propagation_app#/dashboard\">\n      <span class=\"ppn-ic\" style=\"background:rgba(22,163,74,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\"/></svg></span>\n      <span class=\"ppn-tx\"><span class=\"ppn-lb\">Dashboard</span><span class=\"ppn-sub\">Numbers and charts</span></span>\n    </a>\n    <a class=\"ppn-tile\" href=\"/propagation_app#/batches\">\n      <span class=\"ppn-ic\" style=\"background:rgba(22,163,74,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 20h10\"/><path d=\"M10 20c5.5-2.5.8-6.4 3-10\"/><path d=\"M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z\"/><path d=\"M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z\"/></svg></span>\n      <span class=\"ppn-tx\"><span class=\"ppn-lb\">Propagation Batches</span><span class=\"ppn-sub\">Batches and their stage chain</span></span>\n    </a>\n    <a class=\"ppn-tile\" href=\"/propagation_app#/logs\">\n      <span class=\"ppn-ic\" style=\"background:rgba(22,163,74,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><path d=\"M14 2v6h6\"/><path d=\"M8 13h8M8 17h5\"/></svg></span>\n      <span class=\"ppn-tx\"><span class=\"ppn-lb\">Daily Logs</span><span class=\"p